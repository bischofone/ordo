{
	"name": "ordo",
	"version": "0.5.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"test:e2e": "playwright test",
		"serve": "sirv build --single --port 4173",
		"radicale": "scripts/radicale.sh",
		"screenshots": "playwright test --config playwright.screenshots.config.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.2.8",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sirv-cli": "^3.0.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"date-fns": "^4.4.0",
		"dexie": "^4.4.7",
		"dompurify": "^3.4.18",
		"fast-xml-parser": "^5.12.1",
		"fractional-indexing": "^4.0.0",
		"ical.js": "^2.2.1",
		"marked": "^18.2.0"
	},
	"description": "Ordo – local-first Aufgaben-App mit Pools, CalDAV-Sync und Zeiterfassung",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bischofone/ordo.git"
	},
	"homepage": "https://github.com/bischofone/ordo"
}
