# Deine Adresse, unter der App und CalDAV erreichbar sein sollen.
# Der DNS-Eintrag muss auf diesen Server zeigen; Caddy holt das HTTPS-Zertifikat selbst.
DOMAIN=ordo.example.de

# Nextcloud (oder ein anderer CalDAV-Server ohne CORS), mit dem Ordo sich verbinden darf.
# Ordo leitet dann /ext/cloud.example.com/… dorthin weiter. Mehrere mit | trennen.
ORDO_PROXY_HOSTS=
