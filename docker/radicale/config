# Radicale-Konfiguration für docker-compose.yml
[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /config/users
htpasswd_encryption = bcrypt
# Schutz gegen Passwort-Raten
delay = 1

[rights]
# Jeder sieht nur seine eigenen Listen
type = owner_only

[storage]
filesystem_folder = /data/collections

[logging]
level = warning
